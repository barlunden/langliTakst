---
import OmOss from "../components/OmOss.astro";
import PageHeader from "../components/PageHeader.astro";
import Prisliste from "../components/Prisliste.astro";
import Layout from "../layouts/Layout.astro";

export const currentPath = "/priser";

const tilstand = [
  { name: "Leilighet opp til 99 m² BRA", price: "9.000,-" },
  { name: "Leilighet fra 100 til 200 m² BRA", price: "11.000,-" },
  { name: "Bolig opp til 149 m² BRA", price: "14.500,-" },
  { name: "Bolig fra 150 til 249 m² BRA", price: "16.000,-" },
  { name: "Bolig fra 250 m² til 400 m² BRA", price: "18.500,-" },
  { name: "Bolig over 400 m² BRA", price: "Pris etter avtale" }
];

const tillegg = [
  { name: "Hybel/leilighet m/våtrom", price: "3.500,-" },
  { name: "Ved mer enn 3 stk. våtrom, pris pr. våtrom", price: "2.000,-" },
  { name: "Verditakst sammen med tilstandsrapport", price: "3.000,-" },
  { name: "Tilstandsvurdering av helt enkle tilleggsbygg som garasje, uthus o.l. uten innlagt vann/avløp", price: "4.000,-" },
  { name: "Tilstandsvurdering av helt enkle tilleggsbygg som garasje, uthus o.l. med innlagt vann/avløp", price: "5.000,-" },
];

const takster = [
  {
    name: "Enebolig, rekkehus, tomannsbolig, leilighet opp til 250 m² BRA",
    price: "6.000,-",
  },
  {
    name: "Enebolig, rekkehus, tomannsbolig, leilighet fra 250 m² BRA",
    price: "7.000,-",
  },
  { name: "Tomt fra", price: "6.000,-" },
  { name: "Næring fra", price: "20.000,-" },
];

const andreTillegg = [
  { name: "Tillegg for kjøring utenfor Stord kommune." },
  { name: "Rapportavgift kommer alltid i tillegg.", price: "500,- pr. rapport"},
  { name: "Alle priser er inkl mva." },
  { name: "Gjeldende pris for tilstandsrapport er for inntil tre våtrom, dvs. bad og vaskerom. Toalett regnes ikke som våtrom." },
]

const blaa = "hsl(220deg 60% 96%)"
const aprikos = "hsl(40deg 100% 96%)"
const gul = "hsl(54deg 100% 96%)"
const lilla = "hsl(270deg 100% 96%)"
---

<Layout currentPath={currentPath}>
  <div class="">
    <PageHeader pageTitle="Prisliste" />

    <div class="main-container">
      <Prisliste category="Tilstandsrapporter ny forskrift" items={tilstand} bakgrunn={blaa} footnote="Oppdatering av tilstandsrapport: Koster 50% av kostnad fra opprinnelig pris. Dette forutsetter at det er samme eier." />
      <Prisliste category="Pristillegg for:" items={tillegg} bakgrunn={aprikos} />
      <Prisliste category="Takster" items={takster} bakgrunn={gul} extra1="Skadetakst og andre taksttjenester etter medgått tid." extra2="Timesats pr. 1.5.2026 kr 1.750,- inkl mva" />
      <Prisliste category="Diverse tillegg / merknader" items={andreTillegg} bakgrunn={lilla} extra1="Alle andre tjenester etter medgått tid og etter gjeldende timesats." extra2="Timesats pr. 1.5.2026 kr 1.750,- inkl mva" />
    </div>
    <OmOss />
  </div>
</Layout>